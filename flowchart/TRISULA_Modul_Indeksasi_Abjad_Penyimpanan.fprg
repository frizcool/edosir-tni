<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Modul Penamaan Indeks Abjad dan Penyimpanan Fisik TRISULA TNI AD"/>
        <attribute name="authors" value="Letda Czi Fris Wardani"/>
        <attribute name="about" value="Diagram alur algoritma penamaan militer terindeks abjad {NRP}_{KODE}[abjad].pdf, pembuatan folder terisolasi uploads/FOLDER XX/, proteksi direktori, dan pencatatan master path"/>
        <attribute name="saved" value="2026-09-22 03:35:00 PM"/>
        <attribute name="created" value="2026-09-22 03:10:00 PM"/>
        <attribute name="edited" value="2026-09-22 03:35:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nrp" type="String" array="False" size=""/>
            <declare name="slotNomor" type="Integer" array="False" size=""/>
            <declare name="kodeBerkas" type="String" array="False" size=""/>
            <declare name="folderFisik" type="String" array="False" size=""/>
            <declare name="jumlahEksisting" type="Integer" array="False" size=""/>
            <declare name="suffixAbjad" type="String" array="False" size=""/>
            <declare name="namaFileFinal" type="String" array="False" size=""/>
            <declare name="pathLengkap" type="String" array="False" size=""/>
            <declare name="folderAda" type="Boolean" array="False" size=""/>

            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;   MODUL ALGORITMA PENAMAAN INDEKS ABJAD &amp; PENYIMPANAN TERISOLASI&quot;" newline="True"/>
            <output expression="&quot;                    SISTEM TRISULA TNI AD&quot;" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>

            <output expression="&quot;Masukkan NRP Prajurit:&quot;" newline="True"/>
            <input variable="nrp"/>
            <output expression="&quot;Masukkan Nomor Slot Berkas (1 - 33):&quot;" newline="True"/>
            <input variable="slotNomor"/>

            <comment text="Resolusi Kode Katalog Berkas Militer &amp; Direktori Terisolasi"/>
            <if expression="slotNomor &lt; 10">
                <then>
                    <assign variable="kodeBerkas" expression="&quot;0&quot; &amp; ToString(slotNomor)"/>
                    <assign variable="folderFisik" expression="&quot;uploads/FOLDER 0&quot; &amp; ToString(slotNomor) &amp; &quot;/&quot;"/>
                </then>
                <else>
                    <assign variable="kodeBerkas" expression="ToString(slotNomor)"/>
                    <assign variable="folderFisik" expression="&quot;uploads/FOLDER &quot; &amp; ToString(slotNomor) &amp; &quot;/&quot;"/>
                </else>
            </if>

            <output expression="&quot;Katalog Terpilih : Slot &quot; &amp; kodeBerkas" newline="True"/>
            <output expression="&quot;Direktori Tujuan : &quot; &amp; folderFisik" newline="True"/>

            <comment text="Pemeriksaan jumlah arsip yang sudah ada di slot yang sama untuk prajurit ini"/>
            <output expression="&quot;Menjalankan kueri: SELECT COUNT(*) FROM dosir_files WHERE nrp='&quot; &amp; nrp &amp; &quot;' AND kode='&quot; &amp; kodeBerkas &amp; &quot;'...&quot;" newline="True"/>
            <output expression="&quot;Masukkan jumlah berkas yang sudah ada sebelumnya (0 untuk berkas pertama, 1 untuk berkas kedua, dst):&quot;" newline="True"/>
            <input variable="jumlahEksisting"/>

            <comment text="Algoritma penentuan suffix indeks abjad militer"/>
            <if expression="jumlahEksisting == 0">
                <then>
                    <comment text="Berkas perdana tanpa suffix atau suffix A"/>
                    <assign variable="suffixAbjad" expression="&quot;&quot;"/>
                </then>
                <else>
                    <if expression="jumlahEksisting == 1">
                        <then>
                            <assign variable="suffixAbjad" expression="&quot;B&quot;"/>
                        </then>
                        <else>
                            <if expression="jumlahEksisting == 2">
                                <then>
                                    <assign variable="suffixAbjad" expression="&quot;C&quot;"/>
                                </then>
                                <else>
                                    <if expression="jumlahEksisting == 3">
                                        <then>
                                            <assign variable="suffixAbjad" expression="&quot;D&quot;"/>
                                        </then>
                                        <else>
                                            <assign variable="suffixAbjad" expression="&quot;_&quot; &amp; ToString(jumlahEksisting + 1)"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>

            <comment text="Penyusunan Nama Berkas Terstandarisasi"/>
            <assign variable="namaFileFinal" expression="nrp &amp; &quot;_&quot; &amp; kodeBerkas &amp; suffixAbjad &amp; &quot;.pdf&quot;"/>
            <assign variable="pathLengkap" expression="folderFisik &amp; namaFileFinal"/>

            <comment text="Verifikasi Kesiapan Folder Fisik dan Keamanan Server"/>
            <assign variable="folderAda" expression="True"/>
            <if expression="!folderAda">
                <then>
                    <output expression="&quot;Membuat folder fisik otomatis: &quot; &amp; folderFisik &amp; &quot; (Permission: 0755)...&quot;" newline="True"/>
                    <output expression="&quot;Menambahkan proteksi file .htaccess (Deny from all direct HTTP access)...&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Folder fisik siap dan terproteksi dari akses luar tanpa autentikasi.&quot;" newline="True"/>
                </else>
            </if>

            <comment text="Penyimpanan Fisik dan Pembuatan Master Raw Copy"/>
            <output expression="&quot;Memindahkan berkas upload dari temporary ke: &quot; &amp; pathLengkap" newline="True"/>
            <output expression="&quot;Membuat salinan Master Asli Tanpa Watermark (raw_file_path) untuk kebutuhan TTE...&quot;" newline="True"/>
            <output expression="&quot;Menginjeksi watermark dinamis pada salinan tayang: 'DOKUMEN PENDING VERIFIKASI'...&quot;" newline="True"/>
            <output expression="&quot;Mencatat entri berkas ke tabel 'dosir_files' (status='pending', is_verified=0)...&quot;" newline="True"/>

            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;           HASIL PENAMAAN DAN PENYIMPANAN DOSIR RESMI           &quot;" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;Nama Berkas Resmi: &quot; &amp; namaFileFinal" newline="True"/>
            <output expression="&quot;Lokasi Fisik     : &quot; &amp; pathLengkap" newline="True"/>
            <output expression="&quot;Indeks Abjad     : &quot; &amp; suffixAbjad" newline="True"/>
            <output expression="&quot;Status Arsip     : PENDING (Watermark Aktif, Raw Master Tersimpan)&quot;" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
