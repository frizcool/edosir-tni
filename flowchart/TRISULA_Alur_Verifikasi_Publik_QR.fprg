<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Alur Verifikasi Publik QR Code TRISULA TNI AD"/>
        <attribute name="authors" value="Letda Czi Fris Wardani"/>
        <attribute name="about" value="Diagram alur pembacaan QR Code oleh pihak eksternal/penguji melalui verify.php, pencarian token TTE, komparasi hash SHA-256 untuk mendeteksi manipulasi, dan penayangan sertifikat keabsahan arsip"/>
        <attribute name="saved" value="2026-09-22 02:45:00 PM"/>
        <attribute name="created" value="2026-09-22 02:00:00 PM"/>
        <attribute name="edited" value="2026-09-22 02:45:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="tokenInput" type="String" array="False" size=""/>
            <declare name="tokenFound" type="Boolean" array="False" size=""/>
            <declare name="isVerified" type="Boolean" array="False" size=""/>
            <declare name="fileStatus" type="String" array="False" size=""/>
            <declare name="storedHash" type="String" array="False" size=""/>
            <declare name="currentHash" type="String" array="False" size=""/>
            <declare name="hashMatch" type="Boolean" array="False" size=""/>
            <declare name="namaPrajurit" type="String" array="False" size=""/>
            <declare name="nrpPrajurit" type="String" array="False" size=""/>
            <declare name="pangkatPrajurit" type="String" array="False" size=""/>
            <declare name="korpsPrajurit" type="String" array="False" size=""/>
            <declare name="satuanPrajurit" type="String" array="False" size=""/>
            <declare name="jenisDokumen" type="String" array="False" size=""/>
            <declare name="pejabatPengesah" type="String" array="False" size=""/>
            <declare name="tglPengesahan" type="String" array="False" size=""/>

            <output expression="&quot;=== PORTAL VALIDASI PUBLIK QR CODE TRISULA TNI AD (verify.php) ===&quot;" newline="True"/>
            <output expression="&quot;Menerima pembacaan QR Code atau masukkan Token TTE Dokumen:&quot;" newline="True"/>
            <input variable="tokenInput"/>

            <comment text="Pemeriksaan keberadaan token TTE pada pangkalan data"/>
            <if expression="Len(tokenInput) &gt;= 10">
                <then>
                    <assign variable="tokenFound" expression="True"/>
                </then>
                <else>
                    <assign variable="tokenFound" expression="False"/>
                </else>
            </if>

            <if expression="!tokenFound">
                <then>
                    <output expression="&quot;[STATUS: DOKUMEN TIDAK VALID / PALSU]&quot;" newline="True"/>
                    <output expression="&quot;Peringatan: Token TTE '&quot; &amp; tokenInput &amp; &quot;' tidak terdaftar dalam pangkalan data resmi Mabes TNI AD!&quot;" newline="True"/>
                    <output expression="&quot;Kemungkinan dokumen dipalsukan atau tanda tangan elektronik tidak terverifikasi.&quot;" newline="True"/>
                </then>
                <else>
                    <comment text="Simulasi pembacaan data arsip dari relasi natural dosir_files, personel, jenis_berkas, users"/>
                    <assign variable="fileStatus" expression="&quot;approved&quot;"/>
                    <assign variable="isVerified" expression="True"/>
                    <assign variable="namaPrajurit" expression="&quot;Bambang Suryanto&quot;"/>
                    <assign variable="pangkatPrajurit" expression="&quot;Sertu&quot;"/>
                    <assign variable="korpsPrajurit" expression="&quot;Czi&quot;"/>
                    <assign variable="nrpPrajurit" expression="&quot;21120034560790&quot;"/>
                    <assign variable="satuanPrajurit" expression="&quot;Denzibang 3/I Medan&quot;"/>
                    <assign variable="jenisDokumen" expression="&quot;SK Kenaikan Pangkat Terakhir (Kategori 05)&quot;"/>
                    <assign variable="pejabatPengesah" expression="&quot;Letda Czi Fris Wardani (Staf Personel)&quot;"/>
                    <assign variable="tglPengesahan" expression="&quot;2026-09-22 14:30:00 WIB&quot;"/>
                    <assign variable="storedHash" expression="&quot;a7f4b8c9d2e1f0e382716354928170abcd543210987654321fedcba098765432&quot;"/>

                    <if expression="fileStatus == &quot;approved&quot; &amp;&amp; isVerified">
                        <then>
                            <comment text="Uji integritas kriptografi: hitung ulang SHA-256 fisik file saat ini"/>
                            <output expression="&quot;Menghitung ulang hash SHA-256 pada media penyimpanan arsip...&quot;" newline="True"/>
                            <assign variable="currentHash" expression="storedHash"/>

                            <if expression="storedHash == currentHash">
                                <then>
                                    <assign variable="hashMatch" expression="True"/>
                                </then>
                                <else>
                                    <assign variable="hashMatch" expression="False"/>
                                </else>
                            </if>

                            <if expression="hashMatch">
                                <then>
                                    <output expression="&quot;============================================================&quot;" newline="True"/>
                                    <output expression="&quot;[SERTIFIKASI RESMI: DOKUMEN AUTENTIK &amp; SAH TERVERIFIKASI]&quot;" newline="True"/>
                                    <output expression="&quot;Tanda Tangan Elektronik (TTE) Resmi Mabes TNI AD Terkonfirmasi.&quot;" newline="True"/>
                                    <output expression="&quot;------------------------------------------------------------&quot;" newline="True"/>
                                    <output expression="&quot;Nama Prajurit : &quot; &amp; pangkatPrajurit &amp; &quot; &quot; &amp; korpsPrajurit &amp; &quot; &quot; &amp; namaPrajurit" newline="True"/>
                                    <output expression="&quot;NRP           : &quot; &amp; nrpPrajurit" newline="True"/>
                                    <output expression="&quot;Satuan        : &quot; &amp; satuanPrajurit" newline="True"/>
                                    <output expression="&quot;Jenis Arsip   : &quot; &amp; jenisDokumen" newline="True"/>
                                    <output expression="&quot;Disahkan Oleh : &quot; &amp; pejabatPengesah" newline="True"/>
                                    <output expression="&quot;Waktu TTE     : &quot; &amp; tglPengesahan" newline="True"/>
                                    <output expression="&quot;Nomor TTE     : &quot; &amp; tokenInput" newline="True"/>
                                    <output expression="&quot;SHA-256 Digest: &quot; &amp; storedHash" newline="True"/>
                                    <output expression="&quot;============================================================&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;[PERINGATAN INTEGRITAS: DOKUMEN TELAH DIUBAH SECARA ILEGAL!]&quot;" newline="True"/>
                                    <output expression="&quot;Hash SHA-256 tidak cocok dengan catatan saat penandatanganan TTE.&quot;" newline="True"/>
                                </else>
                            </if>
                        </then>
                        <else>
                            <output expression="&quot;[STATUS: DOKUMEN BELUM DISAHKAN]&quot;" newline="True"/>
                            <output expression="&quot;Dokumen masih dalam status pemeriksaan atau ditolak oleh verifikator.&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
