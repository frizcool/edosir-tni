<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Alur Autentikasi dan Login Sistem TRISULA TNI AD"/>
        <attribute name="authors" value="Letda Czi Fris Wardani"/>
        <attribute name="about" value="Diagram alur verifikasi kredensial login, rate limiting anti brute-force, dan pembagian hak akses role"/>
        <attribute name="saved" value="2026-09-22 02:00:00 PM"/>
        <attribute name="created" value="2026-09-22 01:00:00 PM"/>
        <attribute name="edited" value="2026-09-22 02:00:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="username" type="String" array="False" size=""/>
            <declare name="password" type="String" array="False" size=""/>
            <declare name="failedAttempts" type="Integer" array="False" size=""/>
            <declare name="userExists" type="Boolean" array="False" size=""/>
            <declare name="passwordValid" type="Boolean" array="False" size=""/>
            <declare name="accountStatus" type="String" array="False" size=""/>
            <declare name="userRole" type="String" array="False" size=""/>
            <output expression="&quot;=== PORTAL TRISULA TNI AD: HALAMAN LOGIN ===&quot;" newline="True"/>
            <output expression="&quot;Masukkan Username / NRP:&quot;" newline="True"/>
            <input variable="username"/>
            <output expression="&quot;Masukkan Kata Sandi:&quot;" newline="True"/>
            <input variable="password"/>
            <assign variable="failedAttempts" expression="0"/>
            <comment text="Pemeriksaan keamanan proteksi brute-force attack"/>
            <if expression="failedAttempts &gt;= 5">
                <then>
                    <output expression="&quot;PERINGATAN KEAMANAN: Terdeteksi 5x kegagalan login. Akun dan IP terkunci sementara selama 15 menit.&quot;" newline="True"/>
                </then>
                <else>
                    <comment text="Simulasi pemeriksaan data akun pada tabel users"/>
                    <if expression="username == &quot;admin&quot; || Len(username) &gt;= 4">
                        <then>
                            <assign variable="userExists" expression="True"/>
                        </then>
                        <else>
                            <assign variable="userExists" expression="False"/>
                        </else>
                    </if>
                    <if expression="userExists">
                        <then>
                            <comment text="Simulasi verifikasi hash kata sandi (bcrypt)"/>
                            <if expression="password != &quot;&quot;">
                                <then>
                                    <assign variable="passwordValid" expression="True"/>
                                </then>
                                <else>
                                    <assign variable="passwordValid" expression="False"/>
                                </else>
                            </if>
                            <if expression="passwordValid">
                                <then>
                                    <comment text="Pengecekan status persetujuan akun"/>
                                    <if expression="username == &quot;admin&quot;">
                                        <then>
                                            <assign variable="accountStatus" expression="&quot;approved&quot;"/>
                                            <assign variable="userRole" expression="&quot;admin&quot;"/>
                                        </then>
                                        <else>
                                            <assign variable="accountStatus" expression="&quot;approved&quot;"/>
                                            <assign variable="userRole" expression="&quot;personel&quot;"/>
                                        </else>
                                    </if>
                                    <if expression="accountStatus == &quot;pending&quot;">
                                        <then>
                                            <output expression="&quot;LOGIN DITOLAK: Akun Anda berstatus PENDING. Menunggu persetujuan Administrator Satuan.&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <if expression="accountStatus == &quot;rejected&quot;">
                                                <then>
                                                    <output expression="&quot;LOGIN DITOLAK: Akun Anda DITOLAK oleh Admin Satuan. Silakan hubungi Staf Personel.&quot;" newline="True"/>
                                                </then>
                                                <else>
                                                    <output expression="&quot;LOGIN BERHASIL! Selamat Datang di Sistem TRISULA TNI AD.&quot;" newline="True"/>
                                                    <if expression="userRole == &quot;admin&quot;">
                                                        <then>
                                                            <output expression="&quot;Hak Akses: ADMINISTRATOR SATUAN. Membuka /admin/dashboard.php...&quot;" newline="True"/>
                                                        </then>
                                                        <else>
                                                            <output expression="&quot;Hak Akses: PERSONEL PRAJURIT. Membuka /personel/dashboard.php...&quot;" newline="True"/>
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </then>
                                <else>
                                    <output expression="&quot;LOGIN GAGAL: Kata sandi yang Anda masukkan tidak cocok.&quot;" newline="True"/>
                                </else>
                            </if>
                        </then>
                        <else>
                            <output expression="&quot;LOGIN GAGAL: Username atau NRP tidak terdaftar dalam pangkalan data.&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
