<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Modul Penerbitan TTE Kriptografi dan Stempel Digital TRISULA TNI AD"/>
        <attribute name="authors" value="Letda Czi Fris Wardani"/>
        <attribute name="about" value="Diagram alur teknis kalkulasi hash SHA-256 master file, pembangkitan TTE Token militer, pembuatan QR Code payload, serta injeksi running header dan cap stempel digital via modul FPDI/TCPDF"/>
        <attribute name="saved" value="2026-09-22 03:45:00 PM"/>
        <attribute name="created" value="2026-09-22 03:20:00 PM"/>
        <attribute name="edited" value="2026-09-22 03:45:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="fileId" type="Integer" array="False" size=""/>
            <declare name="rawFilePath" type="String" array="False" size=""/>
            <declare name="sha256Digest" type="String" array="False" size=""/>
            <declare name="tteToken" type="String" array="False" size=""/>
            <declare name="qrUrl" type="String" array="False" size=""/>
            <declare name="pejabatPenandatangan" type="String" array="False" size=""/>
            <declare name="jabatanPenandatangan" type="String" array="False" size=""/>
            <declare name="jumlahHalaman" type="Integer" array="False" size=""/>
            <declare name="stampedFilePath" type="String" array="False" size=""/>

            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;   MODUL PENERBITAN TTE KRIPTOGRAFI &amp; STEMPEL DIGITAL FPDI/TCPDF &quot;" newline="True"/>
            <output expression="&quot;                    SISTEM TRISULA TNI AD&quot;" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>

            <output expression="&quot;Masukkan ID Dokumen Dosir yang Telah Lolos Telaah:&quot;" newline="True"/>
            <input variable="fileId"/>
            <output expression="&quot;Nama Pejabat Penandatangan / Verifikator TTE:&quot;" newline="True"/>
            <input variable="pejabatPenandatangan"/>
            <output expression="&quot;Jabatan Resmi Penandatangan (contoh: Pasi Pers Kodim, Kasipers):&quot;" newline="True"/>
            <input variable="jabatanPenandatangan"/>

            <comment text="Tahap 1: Pembacaan Master PDF Bersih"/>
            <assign variable="rawFilePath" expression="&quot;uploads/master_raw/RAW_DOSIR_&quot; &amp; ToString(fileId) &amp; &quot;.pdf&quot;"/>
            <output expression="&quot;Membaca master berkas murni dari: &quot; &amp; rawFilePath" newline="True"/>

            <comment text="Tahap 2: Kalkulasi Kriptografi SHA-256"/>
            <output expression="&quot;Menghitung Secure Hash Algorithm SHA-256 (64 Karakter Hexadesimal)...&quot;" newline="True"/>
            <assign variable="sha256Digest" expression="&quot;e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855&quot;"/>
            <output expression="&quot;SHA-256 Digest: &quot; &amp; sha256Digest" newline="True"/>

            <comment text="Tahap 3: Pembuatan Token Registrasi TTE Unik"/>
            <assign variable="tteToken" expression="&quot;TTE-TRISULA-2026-&quot; &amp; ToString(fileId) &amp; &quot;-F7A9B2&quot;"/>
            <assign variable="qrUrl" expression="&quot;https://trisula-tniad.mil.id/verify.php?token=&quot; &amp; tteToken"/>
            <output expression="&quot;Nomor Register TTE: &quot; &amp; tteToken" newline="True"/>
            <output expression="&quot;URL Verifikasi QR : &quot; &amp; qrUrl" newline="True"/>

            <comment text="Tahap 4: Pembangkitan Gambar QR Code Beresolusi Tinggi"/>
            <output expression="&quot;Membangkitkan matriks QR Code (Tingkat Koreksi Error: Level H - 30%)...&quot;" newline="True"/>

            <comment text="Tahap 5: Pemrosesan Engine FPDI &amp; TCPDF"/>
            <output expression="&quot;Mengimpor halaman master ke dalam canvas TCPDF/FPDI...&quot;" newline="True"/>
            <assign variable="jumlahHalaman" expression="3"/>
            <output expression="&quot;Total halaman dokumen: &quot; &amp; ToString(jumlahHalaman) &amp; &quot; Halaman.&quot;" newline="True"/>

            <output expression="&quot;Menerapkan running header militer pada setiap halaman:&quot;" newline="True"/>
            <output expression="&quot;  &gt;&gt; 'KLASIFIKASI: RAHASIA - ARSIP ELEKTRONIK TNI AD'&quot;" newline="True"/>

            <output expression="&quot;Membubuhkan blok cap stempel dinas pada pojok kanan bawah halaman terakhir:&quot;" newline="True"/>
            <output expression="&quot;  &gt;&gt; Lambang Kartika Eka Paksi + QR Code Validasi&quot;" newline="True"/>
            <output expression="&quot;  &gt;&gt; Register TTE: &quot; &amp; tteToken" newline="True"/>
            <output expression="&quot;  &gt;&gt; Disahkan Oleh: &quot; &amp; pejabatPenandatangan &amp; &quot; (&quot; &amp; jabatanPenandatangan &amp; &quot;)&quot;" newline="True"/>
            <output expression="&quot;  &gt;&gt; Fingerprint Hash SHA-256 Terpatri&quot;" newline="True"/>

            <comment text="Tahap 6: Penguncian dan Penyimpanan Dokumen Ber-TTE Sah"/>
            <assign variable="stampedFilePath" expression="&quot;uploads/FOLDER_VERIFIED/SIGNED_&quot; &amp; tteToken &amp; &quot;.pdf&quot;"/>
            <output expression="&quot;Menyimpan berkas sah yang telah terkunci ke: &quot; &amp; stampedFilePath" newline="True"/>

            <comment text="Tahap 7: Pembaruan Relasi Database"/>
            <output expression="&quot;Memperbarui tabel 'dosir_files' (status='approved', is_verified=1, signature_code='&quot; &amp; tteToken &amp; &quot;')...&quot;" newline="True"/>
            <output expression="&quot;Mencatat transaksi kriptografi ke tabel 'activity_log'...&quot;" newline="True"/>

            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;       PENERBITAN TTE DIGITAL RESMI SELESAI DENGAN SUKSES!       &quot;" newline="True"/>
            <output expression="&quot;Dokumen telah memiliki kekuatan hukum digital dan siap diunduh. &quot;" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
