<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Modul Pencadangan Pangkalan Data TRISULA TNI AD"/>
        <attribute name="authors" value="Letda Czi Fris Wardani"/>
        <attribute name="about" value="Diagram alur teknis pencadangan pangkalan data (Database Dump SQL), penguncian tabel konsisten, kompresi arsip gzip, kalkulasi checksum integritas, dan pencatatan ke tabel backup_log"/>
        <attribute name="saved" value="2026-09-22 04:00:00 PM"/>
        <attribute name="created" value="2026-09-22 03:35:00 PM"/>
        <attribute name="edited" value="2026-09-22 04:00:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="adminId" type="String" array="False" size=""/>
            <declare name="metodeBackup" type="Integer" array="False" size=""/>
            <declare name="namaFileSql" type="String" array="False" size=""/>
            <declare name="namaFileGz" type="String" array="False" size=""/>
            <declare name="ukuranMbSql" type="Real" array="False" size=""/>
            <declare name="ukuranMbGz" type="Real" array="False" size=""/>
            <declare name="checksumSha256" type="String" array="False" size=""/>
            <declare name="backupSukses" type="Boolean" array="False" size=""/>

            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;   MODUL PENCADANGAN PANGKALAN DATA (DATABASE BACKUP ENGINE)    &quot;" newline="True"/>
            <output expression="&quot;                    SISTEM TRISULA TNI AD&quot;" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>

            <output expression="&quot;NRP Petugas Administrator Penanggung Jawab:&quot;" newline="True"/>
            <input variable="adminId"/>

            <output expression="&quot;Pilih Mode Pencadangan:&quot;" newline="True"/>
            <output expression="&quot;1 = Pencadangan Penuh (Seluruh Tabel: Personel, Users, Dosir, Log)&quot;" newline="True"/>
            <output expression="&quot;2 = Pencadangan Khusus Berkas &amp; Metadata Saja&quot;" newline="True"/>
            <input variable="metodeBackup"/>

            <output expression="&quot;Menginisiasi prosedur pengamanan basis data...&quot;" newline="True"/>
            <output expression="&quot;1. Menerapkan read lock sementara (FLUSH TABLES WITH READ LOCK)...&quot;" newline="True"/>
            <output expression="&quot;2. Menarik seluruh struktur DDL dan data DML dari MySQL/MariaDB...&quot;" newline="True"/>

            <assign variable="namaFileSql" expression="&quot;backup_trisula_20260922_154000.sql&quot;"/>
            <assign variable="ukuranMbSql" expression="48.5"/>
            <output expression="&quot;Ekspor file SQL berhasil: &quot; &amp; namaFileSql &amp; &quot; (Ukuran: &quot; &amp; ToString(ukuranMbSql) &amp; &quot; MB)&quot;" newline="True"/>

            <comment text="Kompresi berkas cadangan dengan kompresor Gzip"/>
            <output expression="&quot;3. Mengompresi file SQL menggunakan algoritma GZIP level 9...&quot;" newline="True"/>
            <assign variable="namaFileGz" expression="namaFileSql &amp; &quot;.gz&quot;"/>
            <assign variable="ukuranMbGz" expression="7.2"/>
            <output expression="&quot;Hasil kompresi: &quot; &amp; namaFileGz &amp; &quot; (Hemat 85% ruang disk, ukuran kini: &quot; &amp; ToString(ukuranMbGz) &amp; &quot; MB)&quot;" newline="True"/>

            <comment text="Kalkulasi checksum untuk jaminan integritas arsip"/>
            <output expression="&quot;4. Menghitung checksum SHA-256 arsip cadangan...&quot;" newline="True"/>
            <assign variable="checksumSha256" expression="&quot;9f834abc321d45ef67890123456789abcdef0123456789abcdef0123456789ab&quot;"/>
            <output expression="&quot;Checksum: &quot; &amp; checksumSha256" newline="True"/>

            <output expression="&quot;5. Membuka kunci tabel database (UNLOCK TABLES)...&quot;" newline="True"/>
            <output expression="&quot;6. Memindahkan file terkompresi ke direktori terproteksi: backups/&quot;" newline="True"/>

            <comment text="Pencatatan riwayat backup ke tabel backup_log"/>
            <output expression="&quot;7. Menyimpan entri riwayat ke tabel 'backup_log' (created_by = '&quot; &amp; adminId &amp; &quot;')...&quot;" newline="True"/>
            <assign variable="backupSukses" expression="True"/>

            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;          PENCADANGAN BASIS DATA SELESAI DENGAN SUKSES!          &quot;" newline="True"/>
            <output expression="&quot;Arsip Cadangan  : &quot; &amp; namaFileGz" newline="True"/>
            <output expression="&quot;Ukuran Akhir    : &quot; &amp; ToString(ukuranMbGz) &amp; &quot; MB&quot;" newline="True"/>
            <output expression="&quot;SHA-256 Checksum: &quot; &amp; checksumSha256" newline="True"/>
            <output expression="&quot;Status Keamanan : AMAN &amp; TERVERIFIKASI UNTUK PEMULIHAN (RESTORE)&quot;" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
