<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Alur Analisis Masa Pensiun dan Rotasi Jabatan TRISULA TNI AD"/>
        <attribute name="authors" value="Letda Czi Fris Wardani"/>
        <attribute name="about" value="Diagram alur komputasi intelijen personel untuk Batas Usia Pensiun (BUP) berdasarkan strata kepangkatan (Perwira 58, Bintara/Tamtama 56, PNS 60) dan deteksi dini masa jabatan melampaui 2 tahun (Tour of Duty / Tour of Area)"/>
        <attribute name="saved" value="2026-09-22 02:55:00 PM"/>
        <attribute name="created" value="2026-09-22 02:10:00 PM"/>
        <attribute name="edited" value="2026-09-22 02:55:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="namaPersonel" type="String" array="False" size=""/>
            <declare name="nrp" type="String" array="False" size=""/>
            <declare name="kategoriPangkat" type="String" array="False" size=""/>
            <declare name="tahunLahir" type="Integer" array="False" size=""/>
            <declare name="tahunSekarang" type="Integer" array="False" size=""/>
            <declare name="lamaMenjabatBulan" type="Integer" array="False" size=""/>
            <declare name="bup" type="Integer" array="False" size=""/>
            <declare name="usiaSekarang" type="Integer" array="False" size=""/>
            <declare name="tahunPensiun" type="Integer" array="False" size=""/>
            <declare name="sisaTahunDinas" type="Integer" array="False" size=""/>
            <declare name="statusPensiun" type="String" array="False" size=""/>
            <declare name="rekomendasiRotasi" type="String" array="False" size=""/>

            <output expression="&quot;=== SISTEM TRISULA TNI AD: ANALISIS INTELIJEN BUP &amp; ROTASI JABATAN ===&quot;" newline="True"/>
            <assign variable="tahunSekarang" expression="2026"/>

            <output expression="&quot;Masukkan Nama Prajurit / PNS TNI:&quot;" newline="True"/>
            <input variable="namaPersonel"/>
            <output expression="&quot;Masukkan NRP / NIP:&quot;" newline="True"/>
            <input variable="nrp"/>
            <output expression="&quot;Pilih Kategori Kepangkatan (Ketik: Perwira, Bintara, Tamtama, atau PNS):&quot;" newline="True"/>
            <input variable="kategoriPangkat"/>
            <output expression="&quot;Masukkan Tahun Kelahiran (contoh: 1970, 1985):&quot;" newline="True"/>
            <input variable="tahunLahir"/>
            <output expression="&quot;Masukkan Lama Menjabat di Jabatan Saat Ini (dalam satuan bulan):&quot;" newline="True"/>
            <input variable="lamaMenjabatBulan"/>

            <comment text="Penetapan Batas Usia Pensiun (BUP) berdasarkan regulasi TNI dan ASN"/>
            <if expression="kategoriPangkat == &quot;Perwira&quot; || kategoriPangkat == &quot;PERWIRA&quot;">
                <then>
                    <assign variable="bup" expression="58"/>
                </then>
                <else>
                    <if expression="kategoriPangkat == &quot;Bintara&quot; || kategoriPangkat == &quot;Tamtama&quot; || kategoriPangkat == &quot;BINTARA&quot; || kategoriPangkat == &quot;TAMTAMA&quot;">
                        <then>
                            <assign variable="bup" expression="56"/>
                        </then>
                        <else>
                            <if expression="kategoriPangkat == &quot;PNS&quot; || kategoriPangkat == &quot;pns&quot;">
                                <then>
                                    <assign variable="bup" expression="60"/>
                                </then>
                                <else>
                                    <comment text="Nilai baku cadangan"/>
                                    <assign variable="bup" expression="58"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>

            <comment text="Kalkulasi usia dan tahun pensiun"/>
            <assign variable="usiaSekarang" expression="tahunSekarang - tahunLahir"/>
            <assign variable="tahunPensiun" expression="tahunLahir + bup"/>
            <assign variable="sisaTahunDinas" expression="tahunPensiun - tahunSekarang"/>

            <comment text="Klasifikasi status persiapan masa pensiun"/>
            <if expression="sisaTahunDinas &lt;= 1">
                <then>
                    <assign variable="statusPensiun" expression="&quot;KRITIS PENSIUN (&lt; 1 TAHUN) - Siapkan Masa Persiapan Pensiun (MPP) &amp; Berkas Administrasi&quot;"/>
                </then>
                <else>
                    <if expression="sisaTahunDinas &lt;= 3">
                        <then>
                            <assign variable="statusPensiun" expression="&quot;MENDEKATI PENSIUN (1 s.d. 3 TAHUN) - Pembinaan Karier Tahap Akhir&quot;"/>
                        </then>
                        <else>
                            <assign variable="statusPensiun" expression="&quot;MASA DINAS AKTIF NORMAL&quot;"/>
                        </else>
                    </if>
                </else>
            </if>

            <comment text="Evaluasi masa jabatan untuk Tour of Duty / Tour of Area (Batas 24 bulan / 2 tahun)"/>
            <if expression="lamaMenjabatBulan &gt;= 24">
                <then>
                    <assign variable="rekomendasiRotasi" expression="&quot;PERINGATAN: Sudah menjabat selama &quot; &amp; ToString(lamaMenjabatBulan) &amp; &quot; bulan (&gt; 2 Tahun). Direkomendasikan Tour of Duty / Tour of Area (TOD/TOA).&quot;"/>
                </then>
                <else>
                    <assign variable="rekomendasiRotasi" expression="&quot;STABIL: Masa jabatan masih dalam rentang waktu ideal (&lt; 2 Tahun).&quot;"/>
                </else>
            </if>

            <output expression="&quot;============================================================&quot;" newline="True"/>
            <output expression="&quot;HASIL ANALISIS INTELIJEN PERSONEL TRISULA TNI AD&quot;" newline="True"/>
            <output expression="&quot;Nama Prajurit     : &quot; &amp; namaPersonel &amp; &quot; (NRP: &quot; &amp; nrp &amp; &quot;)&quot;" newline="True"/>
            <output expression="&quot;Kategori Strata   : &quot; &amp; kategoriPangkat &amp; &quot; (BUP: &quot; &amp; ToString(bup) &amp; &quot; Tahun)&quot;" newline="True"/>
            <output expression="&quot;Usia Saat Ini     : &quot; &amp; ToString(usiaSekarang) &amp; &quot; Tahun&quot;" newline="True"/>
            <output expression="&quot;Tahun Pensiun     : &quot; &amp; ToString(tahunPensiun)" newline="True"/>
            <output expression="&quot;Sisa Masa Dinas   : &quot; &amp; ToString(sisaTahunDinas) &amp; &quot; Tahun&quot;" newline="True"/>
            <output expression="&quot;Status Pensiun    : &quot; &amp; statusPensiun" newline="True"/>
            <output expression="&quot;Analisis Jabatan  : &quot; &amp; rekomendasiRotasi" newline="True"/>
            <output expression="&quot;============================================================&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
