<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Alur Global Aplikasi TRISULA TNI AD"/>
        <attribute name="authors" value="Letda Czi Fris Wardani"/>
        <attribute name="about" value="Alur global aplikasi dari layanan publik, registrasi dan approval akun, login berbasis role, dashboard Admin dan Personel, pengelolaan dosir, verifikasi TTE, validasi QR publik, pelaporan, keamanan, dan logout"/>
        <attribute name="saved" value="2026-09-22 03:00:00 PM"/>
        <attribute name="created" value="2026-09-22 02:20:00 PM"/>
        <attribute name="edited" value="2026-09-22 03:00:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="menuUtama" type="Integer" array="False" size=""/>
            <declare name="subRoleMenu" type="Integer" array="False" size=""/>
            <declare name="isLoggedIn" type="Boolean" array="False" size=""/>
            <declare name="currentUserRole" type="String" array="False" size=""/>
            <declare name="isRunning" type="Boolean" array="False" size=""/>
            <declare name="credentialsValid" type="Boolean" array="False" size=""/>
            <declare name="accountStatus" type="String" array="False" size=""/>
            <declare name="registrationValid" type="Boolean" array="False" size=""/>
            <declare name="qrTokenFound" type="Boolean" array="False" size=""/>
            <declare name="documentHashValid" type="Boolean" array="False" size=""/>

            <assign variable="isRunning" expression="True"/>
            <assign variable="isLoggedIn" expression="False"/>
            <assign variable="currentUserRole" expression="&quot;&quot;"/>

            <while expression="isRunning">
                <output expression="&quot;=========================================================================&quot;" newline="True"/>
                <output expression="&quot;     SISTEM INFORMASI DOSIR ELEKTRONIK TRISULA TNI AD&quot;" newline="True"/>
                <output expression="&quot;  (Tata Kelola Rekam Informasi, Sistematika, &amp; Unduhan Lengkap Arsip)&quot;" newline="True"/>
                <output expression="&quot;=========================================================================&quot;" newline="True"/>

                <if expression="!isLoggedIn">
                    <then>
                        <output expression="&quot;PILIHAN MENU UTAMA:&quot;" newline="True"/>
                        <output expression="&quot;1. Masuk ke Portal (Login Prajurit / Administrator)&quot;" newline="True"/>
                        <output expression="&quot;2. Pendaftaran Personel Prajurit Baru&quot;" newline="True"/>
                        <output expression="&quot;3. Validasi Keabsahan Dokumen via QR Code Publik (verify.php)&quot;" newline="True"/>
                        <output expression="&quot;4. Keluar dari Aplikasi&quot;" newline="True"/>
                        <output expression="&quot;Masukkan nomor pilihan Anda (1 - 4):&quot;" newline="True"/>
                        <input variable="menuUtama"/>

                        <if expression="menuUtama == 1">
                            <then>
                                <output expression="&quot;[LOGIN: MASUKKAN USERNAME/NRP DAN KATA SANDI]&quot;" newline="True"/>
                                <output expression="&quot;Sistem memeriksa akun dan hash kata sandi; rate limit mengunci akses 15 menit setelah 5 kegagalan.&quot;" newline="True"/>
                                <output expression="&quot;Simulasikan hasil pemeriksaan kredensial (True jika cocok):&quot;" newline="True"/>
                                <input variable="credentialsValid"/>
                                <if expression="credentialsValid">
                                    <then>
                                        <output expression="&quot;Masukkan status akun dari database (approved / pending / rejected):&quot;" newline="True"/>
                                        <input variable="accountStatus"/>
                                        <if expression="accountStatus == &quot;approved&quot;">
                                            <then>
                                                <output expression="&quot;Masukkan role akun dari database (admin / personel):&quot;" newline="True"/>
                                                <input variable="currentUserRole"/>
                                                <if expression="currentUserRole == &quot;admin&quot; || currentUserRole == &quot;personel&quot;">
                                                    <then>
                                                        <assign variable="isLoggedIn" expression="True"/>
                                                        <output expression="&quot;Login berhasil. Membuka dashboard role: &quot; &amp; currentUserRole" newline="True"/>
                                                    </then>
                                                    <else>
                                                        <assign variable="currentUserRole" expression="&quot;&quot;"/>
                                                        <output expression="&quot;Login ditolak: role akun tidak dikenali.&quot;" newline="True"/>
                                                    </else>
                                                </if>
                                            </then>
                                            <else>
                                                <if expression="accountStatus == &quot;pending&quot;">
                                                    <then>
                                                        <output expression="&quot;Akun menunggu persetujuan Administrator Satuan.&quot;" newline="True"/>
                                                    </then>
                                                    <else>
                                                        <if expression="accountStatus == &quot;rejected&quot;">
                                                            <then>
                                                                <output expression="&quot;Login ditolak: registrasi rejected. Hubungi Administrator Satuan.&quot;" newline="True"/>
                                                            </then>
                                                            <else>
                                                                <if expression="accountStatus == &quot;nonaktif&quot;">
                                                                    <then>
                                                                        <output expression="&quot;Login ditolak: akun nonaktif. Hubungi administrator sistem.&quot;" newline="True"/>
                                                                    </then>
                                                                    <else>
                                                                        <output expression="&quot;Login ditolak: status akun tidak dikenali.&quot;" newline="True"/>
                                                                    </else>
                                                                </if>
                                                            </else>
                                                        </if>
                                                    </else>
                                                </if>
                                            </else>
                                        </if>
                                    </then>
                                    <else>
                                        <output expression="&quot;Login gagal: username/NRP atau kata sandi salah. Sistem mencatat percobaan pada activity_log.&quot;" newline="True"/>
                                    </else>
                                </if>
                            </then>
                            <else>
                                <if expression="menuUtama == 2">
                                    <then>
                                        <output expression="&quot;[PENDAFTARAN PERSONEL BARU]&quot;" newline="True"/>
                                        <output expression="&quot;Validasi format NRP dan data wajib; cek duplikasi; hash kata sandi.&quot;" newline="True"/>
                                        <output expression="&quot;Simulasikan hasil validasi dan cek duplikasi (True jika data valid):&quot;" newline="True"/>
                                        <input variable="registrationValid"/>
                                        <if expression="registrationValid">
                                            <then>
                                                <output expression="&quot;Registrasi tersimpan dengan status PENDING. Admin memprosesnya melalui Approval Akun.&quot;" newline="True"/>
                                            </then>
                                            <else>
                                                <output expression="&quot;Registrasi gagal: data tidak valid atau NRP sudah terdaftar. Perbaiki data lalu coba lagi.&quot;" newline="True"/>
                                            </else>
                                        </if>
                                    </then>
                                    <else>
                                        <if expression="menuUtama == 3">
                                            <then>
                                                <output expression="&quot;[VERIFIKASI PUBLIK DOKUMEN VIA QR]&quot;" newline="True"/>
                                                <output expression="&quot;Cari token TTE pada database. Simulasikan apakah token ditemukan (True/False):&quot;" newline="True"/>
                                                <input variable="qrTokenFound"/>
                                                <if expression="qrTokenFound">
                                                    <then>
                                                        <output expression="&quot;Bandingkan ulang hash SHA-256 dokumen. Simulasikan hash cocok (True/False):&quot;" newline="True"/>
                                                        <input variable="documentHashValid"/>
                                                        <if expression="documentHashValid">
                                                            <then>
                                                                <output expression="&quot;Dokumen valid: token ditemukan dan hash cocok. Tampilkan sertifikat keabsahan.&quot;" newline="True"/>
                                                            </then>
                                                            <else>
                                                                <output expression="&quot;PERINGATAN: hash tidak cocok. Dokumen berubah atau tidak autentik.&quot;" newline="True"/>
                                                            </else>
                                                        </if>
                                                    </then>
                                                    <else>
                                                        <output expression="&quot;Token TTE tidak ditemukan. Dokumen tidak dapat diverifikasi.&quot;" newline="True"/>
                                                    </else>
                                                </if>
                                            </then>
                                            <else>
                                                <if expression="menuUtama == 4">
                                                    <then>
                                                        <output expression="&quot;Terima kasih telah menggunakan Sistem TRISULA TNI AD. Keluar...&quot;" newline="True"/>
                                                        <assign variable="isRunning" expression="False"/>
                                                    </then>
                                                    <else>
                                                        <output expression="&quot;Pilihan tidak valid! Silakan masukkan angka 1 sampai 4.&quot;" newline="True"/>
                                                    </else>
                                                </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </then>
                    <else>
                        <comment text="Sesi masuk terautentikasi"/>
                        <if expression="currentUserRole == &quot;admin&quot;">
                            <then>
                                <output expression="&quot;[DASHBOARD UTAMA ADMINISTRATOR SATUAN]&quot;" newline="True"/>
                                <output expression="&quot;1. Dashboard: statistik personel, kelengkapan 33 dosir, pensiun dan rotasi jabatan&quot;" newline="True"/>
                                <output expression="&quot;2. Verifikasi dosir pending: setujui (TTE/QR) atau tolak dengan catatan&quot;" newline="True"/>
                                <output expression="&quot;3. Approval akun dan pengelolaan data personel/master satuan&quot;" newline="True"/>
                                <output expression="&quot;4. Laporan dan unduh arsip massal&quot;" newline="True"/>
                                <output expression="&quot;5. Log aktivitas, backup/restore, utilitas dan pengaturan&quot;" newline="True"/>
                                <output expression="&quot;6. Keluar sesi (Logout)&quot;" newline="True"/>
                                <output expression="&quot;Pilih menu Admin (1 - 6):&quot;" newline="True"/>
                                <input variable="subRoleMenu"/>

                                <if expression="subRoleMenu == 1">
                                    <then>
                                                <output expression="&quot;Menampilkan dashboard: statistik, kelengkapan 33 dosir, proyeksi BUP, dan peringatan rotasi jabatan.&quot;" newline="True"/>
                                    </then>
                                    <else>
                                        <if expression="subRoleMenu == 2">
                                            <then>
                                                        <output expression="&quot;Memeriksa berkas pending. Jika approve: buat hash SHA-256, token TTE dan QR, stempel PDF, simpan approved. Jika reject: simpan catatan revisi.&quot;" newline="True"/>
                                            </then>
                                            <else>
                                                        <if expression="subRoleMenu == 3">
                                                            <then>
                                                                <output expression="&quot;Memproses approval akun pending, data personel, dan master Kotama/Satuan/Pangkat/Korp.&quot;" newline="True"/>
                                                            </then>
                                                            <else>
                                                                <if expression="subRoleMenu == 4">
                                                                    <then>
                                                                        <output expression="&quot;Menyusun laporan dosir/personel dan menyediakan unduh arsip massal sesuai hak akses.&quot;" newline="True"/>
                                                                    </then>
                                                                    <else>
                                                                        <if expression="subRoleMenu == 5">
                                                                            <then>
                                                                                <output expression="&quot;Mencatat activity_log; mengelola backup database/berkas, utilitas, dan pengaturan sistem.&quot;" newline="True"/>
                                                                            </then>
                                                                            <else>
                                                                                <if expression="subRoleMenu == 6">
                                                                                    <then>
                                                                                        <output expression="&quot;Mengakhiri sesi Administrator. Kembali ke menu publik.&quot;" newline="True"/>
                                                                                        <assign variable="isLoggedIn" expression="False"/>
                                                                                        <assign variable="currentUserRole" expression="&quot;&quot;"/>
                                                                                    </then>
                                                                                    <else>
                                                                                        <output expression="&quot;Pilihan menu tidak valid. Pilih angka 1 sampai 6.&quot;" newline="True"/>
                                                                                    </else>
                                                                                </if>
                                                                            </else>
                                                                        </if>
                                                                    </else>
                                                                </if>
                                                            </else>
                                                        </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </then>
                            <else>
                                <output expression="&quot;[DASHBOARD UTAMA PRAJURIT / PERSONEL]&quot;" newline="True"/>
                                <output expression="&quot;1. Unggah atau scan kamera dokumen pada salah satu dari 33 slot dosir&quot;" newline="True"/>
                                <output expression="&quot;2. Pantau kelengkapan dan status berkas: pending / approved / rejected&quot;" newline="True"/>
                                <output expression="&quot;3. Kelola profil personel&quot;" newline="True"/>
                                <output expression="&quot;4. Unduh arsip yang telah disahkan dengan TTE/QR&quot;" newline="True"/>
                                <output expression="&quot;5. Keluar sesi (Logout)&quot;" newline="True"/>
                                <output expression="&quot;Pilih menu Personel (1 - 5):&quot;" newline="True"/>
                                <input variable="subRoleMenu"/>

                                <if expression="subRoleMenu == 1">
                                    <then>
                                        <output expression="&quot;Validasi slot dan PDF maks. 10 MB; scan kamera opsional; simpan berkas terindeks dengan status pending untuk verifikasi Admin.&quot;" newline="True"/>
                                    </then>
                                    <else>
                                        <if expression="subRoleMenu == 2">
                                            <then>
                                                <output expression="&quot;Menampilkan kelengkapan dosir dan catatan revisi dari Admin; berkas rejected dapat diperbaiki dan diunggah ulang.&quot;" newline="True"/>
                                            </then>
                                            <else>
                                                <if expression="subRoleMenu == 3">
                                                    <then>
                                                        <output expression="&quot;Membuka profil personel untuk melihat dan memperbarui data yang diizinkan.&quot;" newline="True"/>
                                                    </then>
                                                    <else>
                                                        <if expression="subRoleMenu == 4">
                                                            <then>
                                                                <output expression="&quot;Mengunduh arsip dosir yang telah disahkan dan dilengkapi sertifikat TTE/QR.&quot;" newline="True"/>
                                                            </then>
                                                            <else>
                                                                <if expression="subRoleMenu == 5">
                                                                    <then>
                                                                        <output expression="&quot;Mengakhiri sesi Personel. Kembali ke menu publik.&quot;" newline="True"/>
                                                                        <assign variable="isLoggedIn" expression="False"/>
                                                                        <assign variable="currentUserRole" expression="&quot;&quot;"/>
                                                                    </then>
                                                                    <else>
                                                                        <output expression="&quot;Pilihan menu tidak valid. Pilih angka 1 sampai 5.&quot;" newline="True"/>
                                                                    </else>
                                                                </if>
                                                            </else>
                                                        </if>
                                                    </else>
                                                </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
        </body>
    </function>
</flowgorithm>
