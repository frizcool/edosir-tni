<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Modul Kamera Pemindai Dokumen dan jsPDF TRISULA TNI AD"/>
        <attribute name="authors" value="Letda Czi Fris Wardani"/>
        <attribute name="about" value="Diagram alur teknis pemindaian dokumen fisik via browser WebRTC kamera, pemrosesan citra canvas, multi-page scanning, dan kompilasi langsung ke berkas PDF menggunakan library jsPDF"/>
        <attribute name="saved" value="2026-09-22 03:30:00 PM"/>
        <attribute name="created" value="2026-09-22 03:05:00 PM"/>
        <attribute name="edited" value="2026-09-22 03:30:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="izinKamera" type="Boolean" array="False" size=""/>
            <declare name="resolusiKamera" type="String" array="False" size=""/>
            <declare name="jumlahHalaman" type="Integer" array="False" size=""/>
            <declare name="tambahHalamanLagi" type="String" array="False" size=""/>
            <declare name="filterGambar" type="Integer" array="False" size=""/>
            <declare name="namaFilter" type="String" array="False" size=""/>
            <declare name="ukuranPdfMB" type="Real" array="False" size=""/>
            <declare name="isPdfValid" type="Boolean" array="False" size=""/>
            <declare name="scanAktif" type="Boolean" array="False" size=""/>

            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;     MODUL PEMINDAI KAMERA WEBRTC DAN GENERATOR jsPDF           &quot;" newline="True"/>
            <output expression="&quot;                    SISTEM TRISULA TNI AD&quot;" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>

            <comment text="Inisialisasi perangkat keras kamera melalui WebRTC API"/>
            <output expression="&quot;Meminta izin akses kamera perangkat (navigator.mediaDevices.getUserMedia)...&quot;" newline="True"/>
            <comment text="Simulasi izin kamera diberikan pengguna"/>
            <assign variable="izinKamera" expression="True"/>

            <if expression="!izinKamera">
                <then>
                    <output expression="&quot;AKSES DITOLAK: Browser tidak diizinkan mengakses kamera. Silakan periksa pengaturan izin privasi perangkat Anda.&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="resolusiKamera" expression="&quot;1920x1080 Full HD (Kamera Belakang / Environment)&quot;"/>
                    <output expression="&quot;Kamera Aktif: &quot; &amp; resolusiKamera" newline="True"/>
                    <output expression="&quot;Pilih Mode Filter Citra Dokumen:&quot;" newline="True"/>
                    <output expression="&quot;1 = Berwarna Asli (Original Color)&quot;" newline="True"/>
                    <output expression="&quot;2 = Dokumen Kontras Tinggi (High Contrast Black &amp; White)&quot;" newline="True"/>
                    <output expression="&quot;3 = Grayscale Standar Arsip Militer&quot;" newline="True"/>
                    <input variable="filterGambar"/>

                    <if expression="filterGambar == 2">
                        <then>
                            <assign variable="namaFilter" expression="&quot;Black &amp; White (Auto-Contrast Threshold)&quot;"/>
                        </then>
                        <else>
                            <if expression="filterGambar == 3">
                                <then>
                                    <assign variable="namaFilter" expression="&quot;Grayscale Standar Arsip&quot;"/>
                                </then>
                                <else>
                                    <assign variable="namaFilter" expression="&quot;Original Color (RGB)&quot;"/>
                                </else>
                            </if>
                        </else>
                    </if>

                    <output expression="&quot;Filter terpilih: &quot; &amp; namaFilter" newline="True"/>
                    <assign variable="jumlahHalaman" expression="0"/>
                    <assign variable="scanAktif" expression="True"/>

                    <comment text="Siklus pengambilan gambar multi-halaman"/>
                    <while expression="scanAktif">
                        <assign variable="jumlahHalaman" expression="jumlahHalaman + 1"/>
                        <output expression="&quot;--- Mengambil Lembar Dokumen Ke-&quot; &amp; ToString(jumlahHalaman) &amp; &quot; ---&quot;" newline="True"/>
                        <output expression="&quot;Menangkap frame video ke HTML5 Canvas 2D Context...&quot;" newline="True"/>
                        <output expression="&quot;Menerapkan filter citra: &quot; &amp; namaFilter" newline="True"/>
                        <output expression="&quot;Menyimpan data URL JPEG ke dalam buffer memori pemindai...&quot;" newline="True"/>
                        
                        <output expression="&quot;Apakah ingin memindai lembar halaman berikutnya? (Ketik 'ya' atau 'tidak'):&quot;" newline="True"/>
                        <input variable="tambahHalamanLagi"/>

                        <if expression="tambahHalamanLagi == &quot;tidak&quot; || tambahHalamanLagi == &quot;TIDAK&quot; || tambahHalamanLagi == &quot;t&quot;">
                            <then>
                                <assign variable="scanAktif" expression="False"/>
                            </then>
                            <else>
                                <assign variable="scanAktif" expression="True"/>
                            </else>
                        </if>
                    </while>

                    <comment text="Kompilasi lembar hasil foto ke format PDF menggunakan jsPDF"/>
                    <output expression="&quot;Memulai kompilasi dokumen PDF melalui library jsPDF (Format: A4 Portrait)...&quot;" newline="True"/>
                    <output expression="&quot;Menyusun &quot; &amp; ToString(jumlahHalaman) &amp; &quot; lembar halaman ke dalam struktur dokumen PDF tunggal...&quot;" newline="True"/>
                    
                    <comment text="Estimasi ukuran file hasil kompresi (rata-rata 0.6 MB per halaman)"/>
                    <assign variable="ukuranPdfMB" expression="jumlahHalaman * 0.65"/>
                    <output expression="&quot;Kompilasi selesai. Ukuran berkas PDF: &quot; &amp; ToString(ukuranPdfMB) &amp; &quot; MB.&quot;" newline="True"/>

                    <if expression="ukuranPdfMB &lt;= 10.0">
                        <then>
                            <assign variable="isPdfValid" expression="True"/>
                        </then>
                        <else>
                            <assign variable="isPdfValid" expression="False"/>
                        </else>
                    </if>

                    <if expression="isPdfValid">
                        <then>
                            <output expression="&quot;Mengonversi PDF Blob ke objek FormData...&quot;" newline="True"/>
                            <output expression="&quot;Mengirim berkas PDF ke personel/upload_process.php via XMLHttpRequest/AJAX...&quot;" newline="True"/>
                            <output expression="&quot;SUKSES: Seluruh &quot; &amp; ToString(jumlahHalaman) &amp; &quot; lembar berhasil diubah menjadi PDF resmi dan terkirim ke server!&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;GAGAL: Ukuran berkas melebihi batas 10 MB. Kurangi jumlah halaman atau gunakan resolusi lebih hemat.&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
