<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Modul Rekapitulasi dan Laporan Kelengkapan Dosir TRISULA TNI AD"/>
        <attribute name="authors" value="Letda Czi Fris Wardani"/>
        <attribute name="about" value="Diagram alur pembuatan rekapitulasi data agregat berkas dosir prajurit per satuan/kompi, agregasi persentase kelengkapan, dan ekspor dokumen resmi dinas ke format Excel dan PDF Cetak"/>
        <attribute name="saved" value="2026-09-22 04:05:00 PM"/>
        <attribute name="created" value="2026-09-22 03:40:00 PM"/>
        <attribute name="edited" value="2026-09-22 04:05:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="satuanPilihan" type="String" array="False" size=""/>
            <declare name="golonganPilihan" type="String" array="False" size=""/>
            <declare name="formatEkspor" type="Integer" array="False" size=""/>
            <declare name="totalPersonel" type="Integer" array="False" size=""/>
            <declare name="jumlahLengkap100" type="Integer" array="False" size=""/>
            <declare name="jumlahSebagian" type="Integer" array="False" size=""/>
            <declare name="jumlahKurang50" type="Integer" array="False" size=""/>
            <declare name="namaFileEkspor" type="String" array="False" size=""/>
            <declare name="persenLengkapSatuan" type="Integer" array="False" size=""/>

            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;   MODUL REKAPITULASI &amp; PELAPORAN KELENGKAPAN DOSIR SATUAN      &quot;" newline="True"/>
            <output expression="&quot;                    SISTEM TRISULA TNI AD&quot;" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>

            <output expression="&quot;Pilih Satuan Organisasi (contoh: Denzibang 3/I Medan, Kazidam, Semua):&quot;" newline="True"/>
            <input variable="satuanPilihan"/>
            <output expression="&quot;Pilih Strata Kepangkatan (Perwira / Bintara / Tamtama / PNS / Semua):&quot;" newline="True"/>
            <input variable="golonganPilihan"/>
            <output expression="&quot;Pilih Format Keluaran Laporan (1 = Cetak PDF Resmi, 2 = Ekspor Excel XLSX):&quot;" newline="True"/>
            <input variable="formatEkspor"/>

            <output expression="&quot;Menjalankan kueri agregasi relasional pada tabel personel dan dosir_files...&quot;" newline="True"/>
            <assign variable="totalPersonel" expression="85"/>
            <assign variable="jumlahLengkap100" expression="52"/>
            <assign variable="jumlahSebagian" expression="25"/>
            <assign variable="jumlahKurang50" expression="8"/>

            <comment text="Kalkulasi persentase kelengkapan dosir tingkat satuan"/>
            <assign variable="persenLengkapSatuan" expression="(jumlahLengkap100 * 100) / totalPersonel"/>

            <if expression="formatEkspor == 2">
                <then>
                    <assign variable="namaFileEkspor" expression="&quot;Laporan_Rekap_Dosir_&quot; &amp; satuanPilihan &amp; &quot;_2026.xlsx&quot;"/>
                    <output expression="&quot;Menghasilkan spreadsheet Excel menggunakan library PhpSpreadsheet...&quot;" newline="True"/>
                    <output expression="&quot;Menyusun kolom: No, NRP, Nama, Pangkat, Korps, Jabatan, Persentase 33 Berkas, Status TTE...&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="namaFileEkspor" expression="&quot;Laporan_Rekap_Dosir_&quot; &amp; satuanPilihan &amp; &quot;_2026.pdf&quot;"/>
                    <output expression="&quot;Menghasilkan dokumen cetak PDF resmi menggunakan engine TCPDF...&quot;" newline="True"/>
                    <output expression="&quot;Menyematkan Kop Satuan: 'KOMANDO DAERAH MILITER I/BUKIT BARISAN'&quot;" newline="True"/>
                    <output expression="&quot;Menyematkan lembar kolom tanda tangan pertanggungjawaban Perwira Personel.&quot;" newline="True"/>
                </else>
            </if>

            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;        HASIL REKAPITULASI KELENGKAPAN DOSIR TRISULA TNI AD      &quot;" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;Satuan              : &quot; &amp; satuanPilihan" newline="True"/>
            <output expression="&quot;Strata Terpilih     : &quot; &amp; golonganPilihan" newline="True"/>
            <output expression="&quot;Kekuatan Personel   : &quot; &amp; ToString(totalPersonel) &amp; &quot; Prajurit/PNS&quot;" newline="True"/>
            <output expression="&quot;Lengkap 100% (33/33): &quot; &amp; ToString(jumlahLengkap100) &amp; &quot; Orang (&quot; &amp; ToString(persenLengkapSatuan) &amp; &quot;%)&quot;" newline="True"/>
            <output expression="&quot;Sebagian (20-32)    : &quot; &amp; ToString(jumlahSebagian) &amp; &quot; Orang&quot;" newline="True"/>
            <output expression="&quot;Kurang (&lt; 20 Berkas): &quot; &amp; ToString(jumlahKurang50) &amp; &quot; Orang (Perlu Pendampingan)&quot;" newline="True"/>
            <output expression="&quot;Dokumen Terbit      : &quot; &amp; namaFileEkspor" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
