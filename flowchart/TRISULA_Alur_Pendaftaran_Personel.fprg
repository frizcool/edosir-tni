<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Alur Pendaftaran Personel Baru TRISULA TNI AD"/>
        <attribute name="authors" value="Letda Czi Fris Wardani"/>
        <attribute name="about" value="Diagram alur pendaftaran mandiri personel prajurit, validasi format NRP, pencegahan duplikasi, dan pembuatan akun berstatus pending approval"/>
        <attribute name="saved" value="2026-09-22 02:15:00 PM"/>
        <attribute name="created" value="2026-09-22 01:30:00 PM"/>
        <attribute name="edited" value="2026-09-22 02:15:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nrp" type="String" array="False" size=""/>
            <declare name="namaLengkap" type="String" array="False" size=""/>
            <declare name="pangkat" type="String" array="False" size=""/>
            <declare name="korps" type="String" array="False" size=""/>
            <declare name="jabatan" type="String" array="False" size=""/>
            <declare name="satuan" type="String" array="False" size=""/>
            <declare name="tglLahir" type="String" array="False" size=""/>
            <declare name="tmtTni" type="String" array="False" size=""/>
            <declare name="password" type="String" array="False" size=""/>
            <declare name="confirmPassword" type="String" array="False" size=""/>
            <declare name="nrpValid" type="Boolean" array="False" size=""/>
            <declare name="isDuplicateNrp" type="Boolean" array="False" size=""/>
            <declare name="passwordMatch" type="Boolean" array="False" size=""/>
            <declare name="registrationSuccess" type="Boolean" array="False" size=""/>

            <output expression="&quot;=== SISTEM TRISULA TNI AD: PENDAFTARAN PERSONEL BARU ===&quot;" newline="True"/>
            <output expression="&quot;Silakan masukkan Nomor Registrasi Pokok (NRP) / NIP:&quot;" newline="True"/>
            <input variable="nrp"/>

            <comment text="Validasi panjang dan format NRP (minimal 5 digit angka)"/>
            <if expression="Len(nrp) &gt;= 5 &amp;&amp; Len(nrp) &lt;= 20">
                <then>
                    <assign variable="nrpValid" expression="True"/>
                </then>
                <else>
                    <assign variable="nrpValid" expression="False"/>
                </else>
            </if>

            <if expression="!nrpValid">
                <then>
                    <output expression="&quot;PENDAFTARAN GAGAL: Format NRP tidak valid! NRP harus berupa 5 hingga 20 karakter.&quot;" newline="True"/>
                </then>
                <else>
                    <comment text="Pengecekan keunikan data NRP pada database personel dan users"/>
                    <output expression="&quot;Memeriksa pangkalan data untuk NRP: &quot; &amp; nrp &amp; &quot;...&quot;" newline="True"/>
                    <comment text="Simulasi: Jika NRP 12345 diasumsikan sudah terdaftar"/>
                    <if expression="nrp == &quot;12345&quot; || nrp == &quot;admin&quot;">
                        <then>
                            <assign variable="isDuplicateNrp" expression="True"/>
                        </then>
                        <else>
                            <assign variable="isDuplicateNrp" expression="False"/>
                        </else>
                    </if>

                    <if expression="isDuplicateNrp">
                        <then>
                            <output expression="&quot;PENDAFTARAN DITOLAK: NRP &quot; &amp; nrp &amp; &quot; sudah terdaftar dalam sistem TRISULA! Silakan hubungi Staf Personel atau lakukan pemulihan akun.&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;NRP tersedia. Masukkan Nama Lengkap (beserta gelar jika ada):&quot;" newline="True"/>
                            <input variable="namaLengkap"/>
                            <output expression="&quot;Pilih Pangkat (contoh: Letda, Lettu, Kapten, Serka, Praka):&quot;" newline="True"/>
                            <input variable="pangkat"/>
                            <output expression="&quot;Pilih Korps (contoh: Czi, Inf, Kav, Arm, Arh, Cba, Cpm, Chb):&quot;" newline="True"/>
                            <input variable="korps"/>
                            <output expression="&quot;Masukkan Jabatan saat ini:&quot;" newline="True"/>
                            <input variable="jabatan"/>
                            <output expression="&quot;Masukkan Satuan Dinas (contoh: Denzibang 3/I Medan):&quot;" newline="True"/>
                            <input variable="satuan"/>
                            <output expression="&quot;Masukkan Tanggal Lahir (YYYY-MM-DD):&quot;" newline="True"/>
                            <input variable="tglLahir"/>
                            <output expression="&quot;Masukkan TMT Masuk TNI (YYYY-MM-DD):&quot;" newline="True"/>
                            <input variable="tmtTni"/>
                            <output expression="&quot;Buat Kata Sandi (Minimal 6 karakter):&quot;" newline="True"/>
                            <input variable="password"/>
                            <output expression="&quot;Konfirmasi Kata Sandi:&quot;" newline="True"/>
                            <input variable="confirmPassword"/>

                            <comment text="Verifikasi kesesuaian dan kekuatan kata sandi"/>
                            <if expression="password == confirmPassword &amp;&amp; Len(password) &gt;= 6">
                                <then>
                                    <assign variable="passwordMatch" expression="True"/>
                                </then>
                                <else>
                                    <assign variable="passwordMatch" expression="False"/>
                                </else>
                            </if>

                            <if expression="!passwordMatch">
                                <then>
                                    <output expression="&quot;PENDAFTARAN GAGAL: Konfirmasi kata sandi tidak cocok atau panjang kata sandi kurang dari 6 karakter!&quot;" newline="True"/>
                                </then>
                                <else>
                                    <comment text="Proses Transaksi Database: Insert data personel dan user"/>
                                    <output expression="&quot;Menyimpan data prajurit ke tabel 'personel'...&quot;" newline="True"/>
                                    <output expression="&quot;Mengenkripsi kata sandi dengan algoritma BCRYPT...&quot;" newline="True"/>
                                    <output expression="&quot;Membuat record akun di tabel 'users' (Role: personel, Status: pending)...&quot;" newline="True"/>
                                    <assign variable="registrationSuccess" expression="True"/>

                                    <output expression="&quot;============================================================&quot;" newline="True"/>
                                    <output expression="&quot;PENDAFTARAN BERHASIL DISIMPAN!&quot;" newline="True"/>
                                    <output expression="&quot;Nama: &quot; &amp; namaLengkap &amp; &quot; | NRP: &quot; &amp; nrp" newline="True"/>
                                    <output expression="&quot;Status Akun: PENDING (Menunggu Verifikasi &amp; Approval Staf Personel Satuan)&quot;" newline="True"/>
                                    <output expression="&quot;Prajurit belum dapat masuk ke portal hingga akun disetujui Administrator.&quot;" newline="True"/>
                                    <output expression="&quot;============================================================&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
