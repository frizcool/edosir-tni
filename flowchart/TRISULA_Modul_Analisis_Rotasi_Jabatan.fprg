<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Modul Analisis Rotasi Jabatan (TOD/TOA) TRISULA TNI AD"/>
        <attribute name="authors" value="Letda Czi Fris Wardani"/>
        <attribute name="about" value="Diagram alur komputasi intelijen karier untuk deteksi dini prajurit dengan masa dinas jabatan melampaui 2 tahun (24 bulan) guna rekomendasi Tour of Duty dan Tour of Area"/>
        <attribute name="saved" value="2026-09-22 03:20:00 PM"/>
        <attribute name="created" value="2026-09-22 02:55:00 PM"/>
        <attribute name="edited" value="2026-09-22 03:20:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="namaPersonel" type="String" array="False" size=""/>
            <declare name="nrp" type="String" array="False" size=""/>
            <declare name="jabatan" type="String" array="False" size=""/>
            <declare name="satuan" type="String" array="False" size=""/>
            <declare name="tahunTmtJabatan" type="Integer" array="False" size=""/>
            <declare name="bulanTmtJabatan" type="Integer" array="False" size=""/>
            <declare name="tahunSekarang" type="Integer" array="False" size=""/>
            <declare name="bulanSekarang" type="Integer" array="False" size=""/>
            <declare name="totalBulanMenjabat" type="Integer" array="False" size=""/>
            <declare name="tahunMenjabat" type="Integer" array="False" size=""/>
            <declare name="sisaBulan" type="Integer" array="False" size=""/>
            <declare name="kategoriRotasi" type="String" array="False" size=""/>
            <declare name="rekomendasiWanjak" type="String" array="False" size=""/>

            <assign variable="tahunSekarang" expression="2026"/>
            <assign variable="bulanSekarang" expression="9"/>

            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;   MODUL INTELIJEN PERSONEL: ANALISIS ROTASI JABATAN (TOD / TOA)&quot;" newline="True"/>
            <output expression="&quot;                    SISTEM TRISULA TNI AD&quot;" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>

            <output expression="&quot;Masukkan Nama Prajurit:&quot;" newline="True"/>
            <input variable="namaPersonel"/>
            <output expression="&quot;Masukkan NRP:&quot;" newline="True"/>
            <input variable="nrp"/>
            <output expression="&quot;Masukkan Jabatan Saat Ini:&quot;" newline="True"/>
            <input variable="jabatan"/>
            <output expression="&quot;Masukkan Satuan Dinas:&quot;" newline="True"/>
            <input variable="satuan"/>
            <output expression="&quot;Masukkan Tahun TMT Surat Perintah Jabatan (contoh: 2023, 2024):&quot;" newline="True"/>
            <input variable="tahunTmtJabatan"/>
            <output expression="&quot;Masukkan Bulan TMT Surat Perintah Jabatan (1 s.d. 12):&quot;" newline="True"/>
            <input variable="bulanTmtJabatan"/>

            <comment text="Kalkulasi Masa Dinas Jabatan (MDJ) dalam hitungan bulan"/>
            <assign variable="totalBulanMenjabat" expression="((tahunSekarang - tahunTmtJabatan) * 12) + (bulanSekarang - bulanTmtJabatan)"/>
            <assign variable="tahunMenjabat" expression="totalBulanMenjabat / 12"/>
            <assign variable="sisaBulan" expression="totalBulanMenjabat % 12"/>

            <comment text="Evaluasi Batas Waktu Pembinaan Karier Militer (Standar 24 Bulan)"/>
            <if expression="totalBulanMenjabat &gt;= 36">
                <then>
                    <assign variable="kategoriRotasi" expression="&quot;KRITIS / OVERSTAY JABATAN (&gt; 3 TAHUN)&quot;"/>
                    <assign variable="rekomendasiWanjak" expression="&quot;PRIORITAS 1: Wajib diikutsertakan dalam Sidang Wanjak terdekat untuk Tour of Duty / Tour of Area (Regenerasi Struktur)&quot;"/>
                </then>
                <else>
                    <if expression="totalBulanMenjabat &gt;= 24">
                        <then>
                            <assign variable="kategoriRotasi" expression="&quot;MEMENUHI SYARAT ROTASI (&gt; 2 TAHUN / 24 BULAN)&quot;"/>
                            <assign variable="rekomendasiWanjak" expression="&quot;PRIORITAS 2: Masuk daftar nominasi penyegaran Tour of Area atau promosi jabatan setingkat lebih tinggi&quot;"/>
                        </then>
                        <else>
                            <if expression="totalBulanMenjabat &gt;= 12">
                                <then>
                                    <assign variable="kategoriRotasi" expression="&quot;MASA JABATAN OPTIMAL (1 - 2 TAHUN)&quot;"/>
                                    <assign variable="rekomendasiWanjak" expression="&quot;Pertahankan kinerja, fokus pada penyelesaian program kerja satuan dan pembinaan anggota&quot;"/>
                                </then>
                                <else>
                                    <assign variable="kategoriRotasi" expression="&quot;PEJABAT BARU (&lt; 1 TAHUN)&quot;"/>
                                    <assign variable="rekomendasiWanjak" expression="&quot;Masa orientasi dan adaptasi kepemimpinan satuan dinas&quot;"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>

            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;          LEMBAR EVALUASI ROTASI JABATAN PRAJURIT TNI AD         &quot;" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;Nama Prajurit     : &quot; &amp; namaPersonel &amp; &quot; (NRP: &quot; &amp; nrp &amp; &quot;)&quot;" newline="True"/>
            <output expression="&quot;Jabatan / Satuan  : &quot; &amp; jabatan &amp; &quot; - &quot; &amp; satuan" newline="True"/>
            <output expression="&quot;TMT Mulai Tugas   : Bulan &quot; &amp; ToString(bulanTmtJabatan) &amp; &quot; / &quot; &amp; ToString(tahunTmtJabatan)" newline="True"/>
            <output expression="&quot;Masa Dinas Jabatan: &quot; &amp; ToString(totalBulanMenjabat) &amp; &quot; Bulan (&quot; &amp; ToString(tahunMenjabat) &amp; &quot; Tahun &quot; &amp; ToString(sisaBulan) &amp; &quot; Bulan)&quot;" newline="True"/>
            <output expression="&quot;Status Rotasi     : &quot; &amp; kategoriRotasi" newline="True"/>
            <output expression="&quot;Rekomendasi Wanjak: &quot; &amp; rekomendasiWanjak" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
