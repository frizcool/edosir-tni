<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Modul Monitoring Kelengkapan 33 Dosir TRISULA TNI AD"/>
        <attribute name="authors" value="Letda Czi Fris Wardani"/>
        <attribute name="about" value="Diagram alur audit dan pemantauan kelengkapan 33 katalog berkas dosir prajurit untuk persyaratan Usul Kenaikan Pangkat (UKP), Pendidikan Pengembangan (Dikbang), dan Administrasi Personel"/>
        <attribute name="saved" value="2026-09-22 03:25:00 PM"/>
        <attribute name="created" value="2026-09-22 03:00:00 PM"/>
        <attribute name="edited" value="2026-09-22 03:25:00 PM"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="namaPersonel" type="String" array="False" size=""/>
            <declare name="nrp" type="String" array="False" size=""/>
            <declare name="tujuanAudit" type="String" array="False" size=""/>
            <declare name="berkasApproved" type="Integer" array="False" size=""/>
            <declare name="berkasPending" type="Integer" array="False" size=""/>
            <declare name="berkasKosong" type="Integer" array="False" size=""/>
            <declare name="persenSah" type="Integer" array="False" size=""/>
            <declare name="statusKelayakan" type="String" array="False" size=""/>
            <declare name="rekomendasiAudit" type="String" array="False" size=""/>

            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;   MODUL MONITORING AUDIT KELENGKAPAN 33 SLOT DOSIR TNI AD      &quot;" newline="True"/>
            <output expression="&quot;                    SISTEM TRISULA TNI AD&quot;" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>

            <output expression="&quot;Masukkan Nama Prajurit:&quot;" newline="True"/>
            <input variable="namaPersonel"/>
            <output expression="&quot;Masukkan NRP:&quot;" newline="True"/>
            <input variable="nrp"/>
            <output expression="&quot;Tujuan Evaluasi Dosir (UKP / Dikbang / Pensiun / Berkala):&quot;" newline="True"/>
            <input variable="tujuanAudit"/>
            <output expression="&quot;Masukkan Jumlah Berkas Bersertifikat TTE (Approved) [0 s.d. 33]:&quot;" newline="True"/>
            <input variable="berkasApproved"/>
            <output expression="&quot;Masukkan Jumlah Berkas dalam Antrean Periksa (Pending) [0 s.d. 33]:&quot;" newline="True"/>
            <input variable="berkasPending"/>

            <comment text="Kalkulasi sisa slot berkas yang belum pernah diunggah"/>
            <assign variable="berkasKosong" expression="33 - (berkasApproved + berkasPending)"/>
            <assign variable="persenSah" expression="(berkasApproved * 100) / 33"/>

            <comment text="Evaluasi Tingkat Kelengkapan Berkas Administrasi"/>
            <if expression="berkasApproved == 33">
                <then>
                    <assign variable="statusKelayakan" expression="&quot;MEMENUHI SYARAT MUTLAK (100% LENGKAP &amp; BER-TTE)&quot;"/>
                    <assign variable="rekomendasiAudit" expression="&quot;Dokumen lengkap tanpa catatan. Siap diterbitkan Rekomendasi Staf Personel untuk &quot; &amp; tujuanAudit"/>
                </then>
                <else>
                    <if expression="berkasApproved &gt;= 25">
                        <then>
                            <assign variable="statusKelayakan" expression="&quot;MEMENUHI SYARAT MINIMUM BERSYARAT (&quot; &amp; ToString(persenSah) &amp; &quot;%)&quot;"/>
                            <assign variable="rekomendasiAudit" expression="&quot;Dapat diproses sementara, prajurit wajib melengkapi &quot; &amp; ToString(berkasKosong) &amp; &quot; berkas tersisa sebelum batas akhir sidang.&quot;"/>
                        </then>
                        <else>
                            <assign variable="statusKelayakan" expression="&quot;TIDAK MEMENUHI SYARAT / TMS (&quot; &amp; ToString(persenSah) &amp; &quot;%)&quot;"/>
                            <assign variable="rekomendasiAudit" expression="&quot;Pengajuan &quot; &amp; tujuanAudit &amp; &quot; DITUNDA. Staf Personel Satuan wajib memanggil prajurit untuk asistensi pemberkasan.&quot;"/>
                        </else>
                    </if>
                </else>
            </if>

            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;          HASIL AUDIT DOSIR ELEKTRONIK PRAJURIT TNI AD           &quot;" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>
            <output expression="&quot;Nama Prajurit     : &quot; &amp; namaPersonel &amp; &quot; (NRP: &quot; &amp; nrp &amp; &quot;)&quot;" newline="True"/>
            <output expression="&quot;Tujuan Keperluan  : &quot; &amp; tujuanAudit" newline="True"/>
            <output expression="&quot;Slot Disahkan TTE : &quot; &amp; ToString(berkasApproved) &amp; &quot; dari 33 Berkas (&quot; &amp; ToString(persenSah) &amp; &quot;%)&quot;" newline="True"/>
            <output expression="&quot;Slot Menunggu TTE : &quot; &amp; ToString(berkasPending) &amp; &quot; Berkas&quot;" newline="True"/>
            <output expression="&quot;Slot Belum Ada    : &quot; &amp; ToString(berkasKosong) &amp; &quot; Berkas Belum Diunggah&quot;" newline="True"/>
            <output expression="&quot;Status Kelayakan  : &quot; &amp; statusKelayakan" newline="True"/>
            <output expression="&quot;Catatan Verifikator: &quot; &amp; rekomendasiAudit" newline="True"/>
            <output expression="&quot;=================================================================&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
