# Keamanan TRISULA TNI AD: Blokir seluruh akses HTTP publik langsung
# Seluruh berkas warkat hanya dapat diakses melalui controller terautentikasi view_file.php
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
Options -Indexes

# Cegah eksekusi skrip berbahaya di folder unggahan (Anti-Webshell / RCE)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8
