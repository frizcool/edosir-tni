# =====================================================================
# TRISULA TNI AD - Template Environment Configuration (.env.example)
# Panduan: Salin berkas ini menjadi '.env' di server hosting Anda:
#   cp .env.example .env
# Lalu sesuaikan konfigurasi pangkalan data dan alamat domain hosting.
# =====================================================================

# 1. INFORMASI & LINGKUNGAN APLIKASI
# APP_ENV : 'production' (server hosting resmi) atau 'development' (uji coba lokal)
# APP_DEBUG : 'false' pada hosting produksi (Mencegah kebocoran struktur data/error)
APP_NAME="TRISULA TNI AD"
APP_ENV=production
APP_DEBUG=false
APP_KEY=ganti_dengan_32_karakter_acak_rahasia_anda

# 2. ALAMAT URL SISTEM & HOSTING
# APP_URL : Domain lengkap untuk stempel QR Code TTE resmi & verifikasi online
# Contoh: https://edosir.tni-ad.mil.id atau https://domainanda.com
APP_URL=https://domainanda.com

# BASE_URL : Subfolder web server jika tidak berada di root domain
# Di hosting cPanel (public_html) : biarkan kosong ""
# Di localhost XAMPP : /edosir-tni
BASE_URL=""

# 3. KONEKSI PANGKALAN DATA (MYSQL DATABASE HOSTING)
# Sesuaikan dengan nama database dan pengguna yang dibuat di cPanel / phpMyAdmin hosting
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u1234567_edosir_tni
DB_USER=u1234567_admin
DB_PASS="PasswordMySQLHostingKuat#2026"

# 4. PENGATURAN BERKAS & UNGGAHAN DOSIR
# Ukuran maksimum berkas dalam bytes (10485760 = 10 Megabytes)
MAX_UPLOAD_SIZE=10485760

# 5. KEAMANAN SESI & AKSES
# Masa kedaluwarsa sesi (dalam detik: 7200 = 2 Jam)
SESSION_LIFETIME=7200

# Paksa pengalihan ke protokol aman HTTPS (set 'true' jika hosting memiliki sertifikat SSL)
FORCE_HTTPS=true
